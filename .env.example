# Copy to .env.local for local builds; replace with the exact Render URL for your target environment.
# The API value must include /api/v1.
EXPO_PUBLIC_DFY_API_URL=https://YOUR-DFY-BE-SERVICE.onrender.com/api/v1
# Optional. If omitted, mobile derives the SignalR origin from the API URL.
EXPO_PUBLIC_DFY_SIGNALR_URL=
