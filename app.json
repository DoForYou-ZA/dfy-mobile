{
  "expo": {
    "name": "DoForYou",
    "slug": "dfy-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "imageWidth": 160,
      "backgroundColor": "#FFF9F2"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-icon.png",
        "backgroundColor": "#FFF9F2"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.chrismokolare.dfymobile",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "imageWidth": 160,
        "backgroundColor": "#FFF9F2"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "ea0a6446-5189-4f65-bbac-ae1563de949a"
      }
    }
  }
}
