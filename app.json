{
  "expo": {
    "name": "DoForYou",
    "slug": "dfy-mobile",
    "scheme": "doforyou",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-cream.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFF9F2"
    },
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "light"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF9F2"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.chrismokolare.dfymobile",
      "splash": {
        "image": "./assets/splash-cream.png",
        "resizeMode": "cover",
        "backgroundColor": "#FFF9F2"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#FFF9F2"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-cream.png",
          "resizeMode": "cover",
          "backgroundColor": "#FFF9F2",
          "dark": {
            "backgroundColor": "#FFF9F2"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ea0a6446-5189-4f65-bbac-ae1563de949a"
      }
    }
  }
}
